# TallyPulse backend configuration. Copy to `.env` (which is git-ignored) and fill in your own values.
# NEVER commit a real `.env`, and never put real credentials in this file.

# --- required ---------------------------------------------------------------
# HTTP port of the API.
PORT=5000
# MongoDB connection string. Use a database user created for TallyPulse alone, with the minimum rights it needs.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
# Secret used to sign login tokens. Generate a long random value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=<generate-a-long-random-value>

# --- AI (the query planner) ---------------------------------------------------
# Anthropic API key. Without it the chat still starts: every question is answered with an honest
# "planner unavailable" message, and nothing is computed.
ANTHROPIC_API_KEY=<your-anthropic-api-key>
# Optional model overrides (the planner uses ANTHROPIC_PLANNER_MODEL, then ANTHROPIC_MODEL, then a built-in default).
# ANTHROPIC_PLANNER_MODEL=
# ANTHROPIC_MODEL=
# Set to "off" to stop persisting one usage record per AI turn to MongoDB (tests set this).
# AI_USAGE_PERSIST=off
# Ask AI analysis plans (one more planner call for a question one query cannot answer). Unset = on (every analysis plan).
# basic runs only a discount summary, an indicative margin, or one sales total next to one purchase total; off runs none.
# An unrecognised value is treated as off (the server warns at start).
# ASK_AI_ANALYSIS=on

# --- NLU model evaluation (manual; never used by Ask AI) ----------------------------------------
# eval-nlu-models.js measures other models against the same corpus and scoring as the Claude planner. OpenRouter is used
# ONLY by that script: the production chat path always uses Anthropic.
# OPENROUTER_API_KEY=<your-openrouter-api-key>
# Comma-separated OpenRouter model ids to evaluate, e.g. vendor/model-a,vendor/model-b
# OPENROUTER_EVAL_MODELS=
# Requests in flight at once across all models (be gentle with rate limits).
# NLU_EVAL_CONCURRENCY=3
# Optional: auto | tool | json_schema (how structured output is requested), a max_tokens override for reasoning models,
# a per-request timeout in ms, and allow | deny for OpenRouter's provider data-collection preference.
# OPENROUTER_STRUCTURED_MODE=auto
# OPENROUTER_MAX_TOKENS=
# OPENROUTER_TIMEOUT_MS=30000
# OPENROUTER_DATA_COLLECTION=
# NVIDIA API Catalog key for the same evaluation (model ids passed as nvidia:vendor/model; needs --allow-nvidia-trial). Never used by Ask AI.
# NVIDIA_API_KEY=
# NVIDIA reasoning for that evaluation: on | off (off sends chat_template_kwargs {enable_thinking:false}). Unset = provider default.
# --nvidia-thinking=on|off on the command line wins over this.
# NVIDIA_THINKING=

# --- Tally ---------------------------------------------------------------------
# TallyPrime HTTP/JSONEx gateway used by the sync workers and the Connect Tally screen.
# TALLY_URL=http://localhost:9000
# Incremental sync: poll interval (seconds) and the maximum number of vouchers per batch.
# TALLY_SYNC_INTERVAL_SECONDS=60
# TALLY_SYNC_BATCH_SIZE=
# Stock Item and Ledger masters are re-read in full by the same worker, after each company's vouchers: every this many
# hours (default 6; 0 switches it off). Stock Item GST history is not part of it (manual command).
# TALLY_MASTER_REFRESH_HOURS=6
# Reconciliation (marks vouchers deleted in Tally): interval in minutes, and the largest share of a company's
# vouchers one run may mark deleted before it aborts as suspicious.
# RECONCILIATION_INTERVAL_MINUTES=20
# RECONCILIATION_MAX_DELETE_RATIO=0.5
# Self-heal after a reconciliation finds a data/checkpoint mismatch.
# SELF_HEAL_ENABLED=true
# SELF_HEAL_COOLDOWN_MINUTES=360
# SELF_HEAL_MAX_BATCHES=3
# SELF_HEAL_BATCH_SIZE=
# SELF_HEAL_MAX_AUTO_RECOVER=20000
# How long the Sales/Purchase voucher-type classification of a company is cached (minutes).
# VOUCHER_TYPE_CLASSIFICATION_CACHE_TTL_MINUTES=360

# --- Web / data freshness -------------------------------------------------------
# Comma-separated browser origins allowed by CORS (default: the local Vite dev server).
# CORS_ORIGINS=http://localhost:5173
# A company's data is reported "stale" after this many minutes without a successful sync.
# ANALYTICS_FRESHNESS_THRESHOLD_MINUTES=15
